[Unit]
Description=Cosca — Runtime daemon 24/7 (gRPC 14123, sync, backup)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
ExecStart=%h/.cosca/bin/cosca runtime start
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=yes
MemoryMax=2G
EnvironmentFile=%h/.config/cosca/serve.env
Environment=COSCA_RUNTIME_ENABLED=true
WorkingDirectory=%h/Documents/cosca
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cosca-runtime

[Install]
WantedBy=default.target
