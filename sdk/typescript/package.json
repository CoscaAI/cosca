{
  "name": "@cosca/sdk",
  "version": "1.1.0",
  "description": "Official TypeScript SDK for the Cosca Enterprise Platform — interact with the Cosca Runtime programmatically",
  "keywords": [
    "cosca",
    "cli",
    "sdk",
    "runtime",
    "agent",
    "knowledge",
    "memory",
    "context",
    "discovery",
    "plugin"
  ],
  "homepage": "https://github.com/CoscaAI/cosca#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoscaAI/cosca.git",
    "directory": "sdk/typescript"
  },
  "license": "MIT",
  "author": "Cosca Contributors",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "generate:types": "openapi-typescript ../../api/rest/openapi.yaml -o ./src/generated/api.ts",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
