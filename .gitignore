# Cosca runtime — versionado por ordem do Don (2026-08-22), EXCETO lixo transitório:
# - *.db-wal / *.db-shm: sidecars SQLite vivos, mudam a cada escrita do servidor
#   (commit deles = working tree eternamente sujo + snapshot inconsistente)
# - cosca.pid: muda a cada restart
# - logs/ e cache/: regeneráveis, ruído puro
# - knowledge.db: é o ÍNDICE DERIVADO (vetores + grafo + FTS). Pode passar de
#   100MB (limite do GitHub) e é RECONSTRUÍVEL (indexação) — NÃO é fonte de
#   verdade. Por decisão do Don (2026-08-24, arquitetura modular ADR-013):
#   índices derivados NÃO são versionados; só o CORE imutável (chain + blocks
#   + manifest) fica no git (pequeno). Regenerar localmente: cosca knowledge index.
#   ANTES: o knowledge.db entrava no git como snapshot (regra antiga 2026-08-22).
.cosca/logs/
.cosca/cache/
.cosca/cosca.pid
.cosca/knowledge.db
.cosca/projects.db
.cosca/graph.db
.cosca/vector.db
.cosca/fts.db

# Sidecars SQLite vivos — SEMPRE transitórios em qualquer local (mudam a cada escrita)
*.db-wal
*.db-shm


# Accidental .cosca dirs in subdirectories (created by tests running cosca with CWD in subdirs)
# NOTE: `*/**/.cosca/` (NOT `**/.cosca/`) — requires >=1 parent dir so the root
# .cosca/ (whose .cosca/framework/ subdirectory IS versioned) is never excluded at the root.
*/**/.cosca/

# Archived (unused/regenerable — moved out of the working tree by Don's order)
/archived/

# External reference clones (mining — never versioned; they carry their own .git)
/eigen/
.cosca/fallback/knowledge/blender-repo/

# Build artifacts & binaries (anchored to root — do NOT ignore internal/embed/cosca/)
/cosca
/cosca-indexer
bin/
build/
dist/

# Root-owned artifacts (from sudo executions)
.config/

# Secrets
.env
*.env
!.env.example

# OS
.DS_Store

# Go module cache (never versioned)
/go/

# Python
__pycache__/
*.pyc
*.pyo
scripts/voice/venv/
.venv/*
/models

# Node.js (TypeScript SDK)
node_modules/

# Build cache
.cache/
cosca-forex/

# Binários de teste órfãos (go test -c)
*.test

# Training runs — artefatos LoRA (binários pesados, regeneráveis)
/checkpoints/
/training/checkpoints/
/training/data/

# Dados de runtime/teste
/data/

# Logs na raiz
/*.log

# Transient runtime auto-backups (Don policy: lixo transitorio)
# NUNCA versionar: são cópias voláteis do knowledge.db (podem passar de 100MB,
# limite do GitHub) e são lixo transitório. Regra da Decisão 1 (ADR-013, 2026-08-24).
.cosca/backups/
.cosca/assets/
