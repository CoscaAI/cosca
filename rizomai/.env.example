# Conexão Postgres (obrigatória para a API e o seed).
# Porta 5433 no host: o docker-compose mapeia 5433→5432 para não conflitar com
# um Postgres local já na 5432.
DATABASE_URL=postgres://rizomai:rizomai@localhost:5433/rizomai?sslmode=disable

# Porta do gateway HTTP (default 8080)
PORT=8080

# Pepper para hash de API keys (troque em qualquer ambiente que não seja dev)
API_KEY_PEPPER=dev-pepper-change-me

# Rate limit por tenant (req/min — token bucket em memória)
RATE_LIMIT_PER_MIN=60

# 1 = pula migrations no boot (quando você quer gerenciar migrations por fora)
SKIP_MIGRATIONS=0

# ===== FASE 3 — Conectores reais e OAuth =====
# Fila: simulated (demo, marca published) | river (fila real no Postgres)
RIZOMAI_QUEUE=simulated

# Chave de criptografia dos tokens OAuth em repouso (AES-256-GCM):
# hex(64) ou raw(32 bytes). GERAR: openssl rand -hex 32
RIZOMAI_TOKEN_KEY=

# URL publica da API (para redirect_uri do OAuth)
PUBLIC_BASE_URL=http://localhost:8080

# Twitter/X (OAuth 2.0 PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn (OAuth 2.0)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Telegram (bot token - sem OAuth)
TELEGRAM_BOT_TOKEN=

# ===== EXPANSAO — Credenciais das demais plataformas (conectores reais) =====
# Instagram (Business) / Facebook / Threads (Meta Graph API)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# YouTube (Google OAuth)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Bluesky (app password - sem OAuth)
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Reddit (script flow)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Pinterest (OAuth v5)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Snapchat (Story API - allowlist)
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# Google Business (My Business API)
GOOGLEBUSINESS_CLIENT_ID=
GOOGLEBUSINESS_CLIENT_SECRET=

# ===== FASE 5 — Billing (Stripe) =====
# Chave secreta do Stripe (modo TEST para desenvolvimento)
STRIPE_SECRET_KEY=
# Secret do WebhookEndpoint do Stripe (para validar assinaturas)
STRIPE_WEBHOOK_SECRET=
# Moeda e metodos de pagamento (Brasil: BRL + pix)
STRIPE_CURRENCY=BRL
STRIPE_PAYMENT_METHODS=card,pix
# Price IDs dos planos (criar na Dashboard do Stripe)
STRIPE_PRICE_FREE=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ESCALA=
STRIPE_PRICE_AGENCIA=

# ===== FASE 6 — MCP (AI agents) =====
# URL da API e API key usadas pelo servidor MCP (proxy para a API)
RIZOMAI_API_URL=http://localhost:8080
RIZOMAI_API_KEY=
